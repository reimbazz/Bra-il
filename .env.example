# Copie para .env e preencha com as credenciais do seu Neon de DESENVOLVIMENTO.
# Nunca commitar o .env real — ver .gitignore.
# Em produção estes valores vivem em GitHub Secrets (Actions) e Vercel Env Vars,
# nunca neste arquivo.

# Usada pelo job de ingestão (backend/) — role com SELECT/INSERT/UPDATE só no schema "raw"
NEON_DATABASE_URL_INGEST=postgresql://ingest:senha@host/neondb?sslmode=require

# Usada pelo dbt (dbt/) — role que materializa staging/intermediate/marts.
# dbt-postgres não aceita connection string única, só campos separados
# (ver dbt/profiles.yml).
DBT_PGHOST=host-do-seu-projeto.neon.tech
DBT_PGUSER=dbt_transform
DBT_PGPASSWORD=senha
DBT_PGDATABASE=neondb

# Usada pela API (api/) — role SOMENTE LEITURA (SELECT) nos marts, endpoint pooled do Neon
DATABASE_URL_READONLY=postgresql://api_readonly:senha@host-pooler/neondb?sslmode=require

# Origens permitidas por CORS na API (separadas por vírgula), nunca "*"
ALLOWED_ORIGINS=http://localhost:5173

# Webhook de alerta de falha do pipeline (Discord ou Slack)
DISCORD_WEBHOOK_URL=
