# Copie para .env.local (Vite) durante desenvolvimento.
# Nunca colocar segredo real aqui: tudo em VITE_* vai pro bundle público do navegador.

# Em dev, a API roda separada (uvicorn na porta 8000) do Vite (porta 5173),
# então precisa da URL absoluta. Em produção (Vercel, ADR 0005) isso vira
# "/api" — mesma origem do frontend, configurado direto no painel da Vercel,
# não neste arquivo.
VITE_API_BASE_URL=http://localhost:8000/api
